{
  "name": "onlygainsv2",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  // Dashboard-set variables survive every `wrangler deploy` from the build
  // pipeline. Without this, each merge wipes anything added in the dashboard
  // UI as plain-text vars (the PR #8 secret-wipe incident).
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only API calls hit the worker; everything else is served as static
    // assets directly from the edge (fast path unchanged).
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    // 17:00/20:00 UTC daily = STREAK_AT_RISK sweeps (18:00/21:00 London BST).
    // Monday 00:30 UTC = weekly crowns; 1st of month 00:30 UTC = monthly
    // crowns (both score the just-completed period). The worker branches on
    // the cron expression in scheduled().
    "crons": ["0 17 * * *", "0 20 * * *", "30 0 * * 1", "30 0 1 * *"]
  }
}
